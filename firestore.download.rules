rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /downloadRegistrations/{registrationId} {
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'platform', 'consent', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'platform', 'consent', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.platform in ['windows', 'macos', 'linux', 'android']
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
